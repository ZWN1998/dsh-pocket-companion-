{
  "name": "@dsh-pocket/companion",
  "version": "0.1.0",
  "description": "DSH Pocket companion - phone pairing settings and QR pairing link generator.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/en.json",
    "locale/zh.json",
    "docs/DETAIL.md",
    "vendor/qrcode.cjs"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "connection",
        "locale"
      ]
    }
  }
}
